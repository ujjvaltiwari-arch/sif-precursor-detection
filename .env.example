# =============================================================
# SIF Precursor Detection — Environment Configuration
# Copy this file to .env and edit as needed
# =============================================================

# Application
APP_NAME="SIF Precursor Detection"
APP_VERSION=1.0.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Database (SQLite for dev, switch to PostgreSQL for prod)
DATABASE_URL=sqlite:///./sif_detection.db

# ML Model
MODEL_STAGE=baseline          # baseline | transformer
MODEL_PATH=models/baseline
CONFIDENCE_THRESHOLD=0.5
HIGH_RISK_THRESHOLD=0.7
MEDIUM_RISK_THRESHOLD=0.4

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Logging
LOG_LEVEL=INFO

# File Upload
MAX_UPLOAD_SIZE_MB=10

# Synthetic Data
SYNTHETIC_DATA_PATH=data/synthetic
